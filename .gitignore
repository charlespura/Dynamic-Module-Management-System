# =============================================
# PWA Specific Files (Add these)
# =============================================

# Generated PWA icons (keep source icons, ignore generated)
/public/icons/*.png
!/public/icons/source/
/public/icons/*.jpg
/public/icons/*.jpeg

# Generated screenshots (keep source screenshots)
/public/screenshots/*.png
!/public/screenshots/source/

# Service worker (generated by build process)
/public/service-worker.js

# Manifest (generated by build process)
/public/manifest.json

# PWA build output
/public/sw.js
/public/offline.html
/public/workbox-*.js

# PWA source files (keep these)
# !/public/icons/source/
# !/public/screenshots/source/

